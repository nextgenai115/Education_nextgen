# Google Analytics 4 Measurement ID (Config - required for client-side tracking)
# Note: GA4 measurement ID is meant to be public as it's exposed in browser
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# n8n Webhook URL (preferred over Google Apps Script for Google Sheets integration)
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/enrollment

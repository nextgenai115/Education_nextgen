# Promo Code (Secret - used server-side in email templates)
PROMO_CODE=

# Resend.com API Key (Secret - server-side only)
RESEND_API_KEY=your_resend_api_key_here

# Email From Address (Secret - must be verified in Resend)
EMAIL_FROM=example@gmail.com

# Google Sheets Webhook URL (Secret - Google Apps Script deployment URL)
GOOGLE_SHEETS_WEBHOOK_URL=your_google_apps_script_webhook_url_here

# Google Analytics 4 Measurement ID (Config - required for client-side tracking)
# Note: GA4 measurement ID is meant to be public as it's exposed in browser
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
